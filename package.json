{
  "name": "lingo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.app.json && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types --strict-vars=false"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "~5.0.3",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  }
}
