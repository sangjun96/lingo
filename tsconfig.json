{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "@/*": ["./src/client/*"] },
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["./worker-configuration.d.ts", "node"]
  },
  "include": ["src/worker/**/*.ts", "vite.config.ts", "vitest.config.mts", "worker-configuration.d.ts"]
}
